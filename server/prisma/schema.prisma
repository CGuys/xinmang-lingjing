datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. 小程序用户表
model User {
  id              String         @id @default(uuid())
  openid          String         @unique
  bonus_energy    Int            @default(0)
  last_free_date  String?        // 格式: "YYYY-MM-DD"
  free_used_today Int            @default(0)
  is_blacklisted  Boolean        @default(false)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  readings            TarotReading[]
  invitationsReceived Invitation[]   @relation("Invitee")
  invitationsSent     Invitation[]   @relation("Inviter")
}

// 2. 裂变邀请记录表 (三元唯一索引防重复刷点)
model Invitation {
  id          String   @id @default(uuid())
  inviter_id  String
  invitee_id  String
  date_str    String   // 格式: "YYYY-MM-DD"
  created_at  DateTime @default(now())

  inviter     User     @relation("Inviter", fields: [inviter_id], references: [id])
  invitee     User     @relation("Invitee", fields: [invitee_id], references: [id])

  @@unique([inviter_id, invitee_id, date_str])
}

// 3. 塔罗抽牌与解读记录表
model TarotReading {
  id             String   @id @default(uuid())
  user_id        String
  card_id        Int
  card_name      String
  orientation    String   @default("upright") // upright (正位) | reversed (逆位)
  user_question  String?
  reading_result String?
  status         String   @default("pending") // pending | streaming | completed | failed
  created_at     DateTime @default(now())

  user           User     @relation(fields: [user_id], references: [id])
}

// 4. 业务策略与运行配置表 (键值存储)
model SystemSetting {
  key         String   @id
  value       String
  description String?
  updated_at  DateTime @updatedAt
}

// 5. 违禁敏感词字典
model SensitiveWord {
  id         Int      @id @default(autoincrement())
  word       String   @unique
  category   String   @default("superstition") // superstition | politics | abuse
  created_at DateTime @default(now())
}

// 6. 运营后台管理员表
model AdminUser {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String
  role       String   @default("admin")
  created_at DateTime @default(now())
}

// 7. 78 张卡牌全量心理资产与页面 OSS 资源映射表
model TarotCard {
  id                Int      @id // 0~77 卡牌唯一索引编号
  name_cn           String   // 中文牌名（如：愚者）
  name_en           String   // 英文牌名（如：The Fool）
  slug              String   // 唯一标识（如：the-fool）
  category          String   // major | wands | cups | swords | pentacles
  category_name     String   // 大阿卡纳 | 权杖 | 圣杯 | 宝剑 | 星币
  roman             String?  // 罗马数字标号 (0, I, II...)
  element           String?  // 能量定调 / 核心意象
  tags              String   // JSON 字符串数组，如 '["破局启程","纯粹好奇"]'
  quote             String?  // 每日正念金句
  insight           String?  // 荣格潜意识投射原型深度解析
  challenge         String?  // 认知盲区与自我防卫挑战
  guidance          String?  // 今日正念行动微建议
  affirmation       String?  // 自我赋能肯定语

  // 多页面 OSS 存储路径与访问直链
  home_image_key    String?  // 首页 3D 抽牌缩略图 OSS Key (pages/home/cards/card_00_the_fool.jpg)
  home_image_url    String?  // 首页缩略图 OSS 访问链接
  reading_image_key String?  // 结果与海报页高清大图 OSS Key (pages/reading/cards/card_00_the_fool.jpg)
  reading_image_url String?  // 结果页大图 OSS 访问链接
  back_image_key    String?  // 卡背 OSS Key (pages/home/card_back.jpg)
  back_image_url    String?  // 卡背 OSS 访问链接

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

// 8. 全站多页面静态与动效资源资产明细表
model PageAsset {
  id          String   @id @default(uuid())
  page        String   // home | reading | poster | history | admin
  page_name   String   // 页面中文名（如：灵境主台首页）
  asset_name  String   // 资源语义名称
  asset_type  String   // card_front | card_back | illustration | icon
  local_path  String   // 本地相对路径
  oss_key     String   @unique // OSS 存储路径
  oss_url     String   // OSS 访问地址
  file_size   Int?     // 文件大小字节数
  mime_type   String?  // image/jpeg, image/png 等
  description String?  // 资源用途描述
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

