# 服务端口与监听主机 (0.0.0.0 支持局域网 IP 跨设备访问)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# 数据库连接 (默认 SQLite 开箱即用，可替换为 postgresql://... 或 mysql://...)
DATABASE_URL="file:./dev.db"

# JWT 签名密钥与有效时间
JWT_SECRET="xinmang_lingjing_super_jwt_secret_key_2026"
JWT_EXPIRES_IN="7d"

ADMIN_JWT_SECRET="xinmang_lingjing_admin_super_jwt_secret_2026"
ADMIN_JWT_EXPIRES_IN="2d"

# 微信小程序配置 (若为空则自动启用开发者 Mock 模式)
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# Redis 缓存连接 (若留空或连接失败，系统将平滑降级为内置高性能内存 Map 缓存)
REDIS_URL=""

# 大模型默认配置 (支持 DeepSeek / 智谱 GLM / OpenAI 兼容格式)
LLM_PROVIDER="deepseek"
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1000

# 静态资源服务路径（指向原画目录）
ASSETS_PATH="../assets"
